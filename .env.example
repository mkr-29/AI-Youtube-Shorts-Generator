# ==============================================================================
# AI Shorts & Reels Automation Configuration
# ==============================================================================

# 1. Google Gemini API Key (REQUIRED for Ideation & Scripting)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key

# Optional: Gemini model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# 2. Visual Sources (OPTIONAL - Zero-Key AI Generation by Default)
# If no key is set below, the system automatically uses Pollinations AI (Flux)
# to generate custom 1080x1920 visuals with smooth Ken Burns motion for FREE.
#
# Option A: Pixabay Stock Video (Free instant key at: https://pixabay.com/api/docs/)
PIXABAY_API_KEY=
#
# Option B: Pexels Stock Video (Free, but key issuance currently paused by Pexels)
PEXELS_API_KEY=

# 3. YouTube Shorts Auto-Upload (OPTIONAL)
# Run `python authorize_youtube.py` once to generate these credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# 4. Instagram Reels Auto-Upload (OPTIONAL)
# Requires an Instagram Creator or Business account linked to a Facebook Page
# Generate token at: https://developers.facebook.com/ (with instagram_content_publish permission)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# 5. Web UI (OPTIONAL)
APP_PASSWORD=
FLASK_SECRET_KEY=
