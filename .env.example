# ==============================================================================
# AI Shorts & Reels Automation Configuration
# ==============================================================================

# 1. Google Gemini API Key (Required for Ideation & Scripting)
# Get free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key

# Optional: Gemini model (default: gemini-2.5-flash or gemini-1.5-pro-latest)
GEMINI_MODEL=gemini-2.5-flash

# 2. Pexels Stock Video API Key (Required for HD 9:16 background clips)
# Get free key at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key

# 3. YouTube Shorts Auto-Upload (Optional)
# Run `python authorize_youtube.py` once to generate these credentials
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token

# 4. Instagram Reels Auto-Upload (Optional)
# Requires an Instagram Creator or Business account linked to a Facebook Page
# Generate token at: https://developers.facebook.com/ (with instagram_content_publish permission)
INSTAGRAM_ACCESS_TOKEN=your_instagram_graph_api_long_lived_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# 5. Web UI (Optional)
APP_PASSWORD=
FLASK_SECRET_KEY=
